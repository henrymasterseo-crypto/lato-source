ProfileName = "UFO-LatoItaD"
ProfileDir = "Source-UFO"
SetFormat.FileFormat = FORMAT::UFO: Unified Font Object
SetFormat.LegacyFormat = False
SetOutline.OutlineConversion = OUTLINE::All curves to PostScript
SetOutline.ConversionPrecision = TOLERANCE::Current, as in Preferences
SetOutline.CorrectDirection = False
SetOutline.RemoveOverlaps = False
SetOutline.RemoveLoops = False
SetOutline.NodesAtExtremesX = False
SetOutline.NodesAtExtremesY = False
SetOutline.CleanUp = False
SetOutline.Round = ROUND::Round nodes and handles to integers
SetOutline.OpenContours = OPENCONTOURS::Close with straight line
SetCompression.TtComposites = COMPOSITES::Keep all (small file)
SetCompression.Subrotinize = False
SetCompression.UfoZ = False
SetHinting.Hinting = True
SetHinting.Autohint = AUTOHINT::No
SetHinting.HintXDirection = False
SetHinting.RecalcZones = False
SetHinting.RecalcStems = False
SetTtHinting.TTHinter = TTAUTOHINTER::Specified in Font Info
SetTtHinting.TthCompileVisualHints = True
SetTtHinting.TthWriteOriginalHinting = True
SetTtHinting.TthRebuildPSHints = False
SetGlyphs.AddRequiredGlyphs = False
SetGlyphs.Reorder = False
SetGlyphs.GlyphNames = GLYPHNAMES::Use current glyph names
FeatKern.OtFeatures = OTFEA::Compile features code if binary not present
FeatKern.OtFeaturesKern = OTFEAKERN::Do not create [kern] code
FeatKern.OtFeaturesMark = OTFEAMARK::Do not create [mark/mkmk] code
FeatKern.TtKernTable = False
FeatKern.TtKernTableMax = 10920
SetWeb.WOFF2 = False
SetWeb.WOFF = False
SetWeb.EOT = False
SetColor.SVG = False
